APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=/app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Only needed for `php artisan backup:run` on machines where `mysqldump`
# isn't on the OS PATH, e.g. C:\xampp\mysql\bin\mysqldump.exe on Windows.
# DB_MYSQLDUMP_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

INFOBIP_ENABLED=true
# Infobip issues a personalized base URL per account (Account Overview page
# in the Infobip portal) -- there is no shared default across customers.
INFOBIP_BASE_URL=https://xxxxxxx.api.infobip.com
INFOBIP_API_KEY=your-infobip-api-key
INFOBIP_SENDER=Dentavaria
MOBILE_OTP_DIGITS=6
# Optional: when set, every OTP (login/forgot-password) uses this fixed code
# instead of a random one -- handy for demo/staging logins. Leave unset in
# real production so OTPs stay random.
# MOBILE_OTP_FIXED_CODE=505050

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Daily automated backup (database + app files), see config/backup.php.
# BACKUP_DISKS accepts a comma-separated list of filesystem disks, e.g.
# "local,s3" once cloud storage credentials are configured -- keeping an
# off-server copy is strongly recommended for production.
BACKUP_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Days after a client's last completed visit before they receive an
# automated recall SMS/email nudging them to book a follow-up. Leave a
# company's recall_interval_days unset to keep recalls disabled for it.
PATIENT_RECALL_DEFAULT_INTERVAL_DAYS=180

# WhatsApp Cloud API base URL -- each company brings its own access token
# and phone_number_id via Settings > WhatsApp (WhatsAppSettingsController),
# this is just the shared Meta endpoint, rarely needs changing.
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v20.0

# Zoho CRM defaults offered in Settings > CRM (CrmSettingsController) --
# each company can override per-connection since Zoho accounts are
# region-locked (.com/.eu/.in/.com.cn/.jp...).
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

VITE_APP_NAME="${APP_NAME}"
