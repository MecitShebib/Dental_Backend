APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=/app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# Only needed for `php artisan backup:run` on machines where `mysqldump`
# isn't on the OS PATH, e.g. C:\xampp\mysql\bin\mysqldump.exe on Windows.
# DB_MYSQLDUMP_PATH=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# KVKK/veri güvenliği: admin panel session'ları kişisel veri (kullanıcı
# kimliği, yetki bilgisi) taşıdığından üretimde şifreli tutulmalı.
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# KVKK: if S3 (or another BACKUP_DISKS entry) gets enabled, prefer an EU
# region over the us-east-1 default below -- that setting alone determines
# where a full copy of every clinic's patient data physically lives.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

ILETIMERKEZI_ENABLED=true
# İleti Merkezi (Turkey-domiciled SMS provider -- see IletiMerkeziSmsService
# for why this was chosen over a foreign one). Both the key and hash come
# from the "API Bilgileri" page of the İleti Merkezi panel.
ILETIMERKEZI_API_KEY=your-iletimerkezi-api-key
ILETIMERKEZI_API_HASH=your-iletimerkezi-api-hash
# Must be a sender title ("başlık") pre-approved in the İleti Merkezi panel.
ILETIMERKEZI_SENDER=Dentavaria
MOBILE_OTP_DIGITS=6
# Optional: when set, every OTP (login/forgot-password) uses this fixed code
# instead of a random one -- handy for demo/staging logins. Leave unset in
# real production so OTPs stay random.
# MOBILE_OTP_FIXED_CODE=505050
# "sms" (default) sends login/forgot-password OTP codes via SMS as today;
# "email" sends them to the user's own email address instead. Switching to
# "email" also needs MAIL_MAILER configured with a real mailer above --
# with MAIL_MAILER=log, OTP emails are only written to the log, never
# actually delivered.
MOBILE_OTP_CHANNEL=sms
# Second factor required on every /admin login: an OTP is always emailed
# here, never to the logging-in admin's own address, and never shown or
# typed anywhere in the login UI. Needs a real MAIL_MAILER to actually
# deliver (MAIL_MAILER=log only writes it to the log).
ADMIN_LOGIN_OTP_EMAIL=info@doctovaria.com.tr

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_WHISPER_MODEL=whisper-1

# Gates the "3D Odontogram" tab on Client Details (frontend) and the X-ray
# AI odontogram analysis job that feeds it (see config/features.php). Off
# by default -- set to true to turn the 3D section back on.
THREE_D_ODONTOGRAM_ENABLED=false

# Daily automated backup (database + app files), see config/backup.php.
# BACKUP_DISKS accepts a comma-separated list of filesystem disks, e.g.
# "local,s3" once cloud storage credentials are configured -- keeping an
# off-server copy is strongly recommended for production.
BACKUP_DISKS=local
# KVKK: the archive contains full patient/health data. Set a real password
# in production -- an unencrypted backup of the whole database is the
# single biggest "veri güvenliği" gap an otherwise-locked-down app can have.
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# Days after a client's last completed visit before they receive an
# automated recall SMS/email nudging them to book a follow-up. Leave a
# company's recall_interval_days unset to keep recalls disabled for it.
PATIENT_RECALL_DEFAULT_INTERVAL_DAYS=180

# WhatsApp Cloud API base URL -- each company brings its own access token
# and phone_number_id via Settings > WhatsApp (WhatsAppSettingsController),
# this is just the shared Meta endpoint, rarely needs changing.
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v20.0

# Zoho CRM defaults offered in Settings > CRM (CrmSettingsController) --
# each company can override per-connection since Zoho accounts are
# region-locked (.com/.eu/.in/.com.cn/.jp...).
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_API_BASE_URL=https://www.zohoapis.com

VITE_APP_NAME="${APP_NAME}"

# In-app Help & Support page: where its request form is emailed, and the
# phone/WhatsApp number shown to clinic users (blank = hidden).
SUPPORT_EMAIL=hello@doctovaria.com
SUPPORT_PHONE=
SUPPORT_WHATSAPP=
AI_TOKEN_PRICE_PER_MILLION="$20"

# Legal identity shown on /privacy-policy and /terms-of-service (KVKK m.10
# requires the data controller's identity). Blank lines are omitted.
LEGAL_ENTITY_NAME=Doctovaria
LEGAL_ENTITY_ADDRESS=
LEGAL_ENTITY_MERSIS=
LEGAL_ENTITY_KEP=
PRIVACY_EMAIL=

# Optional: keep every uploaded file OUTSIDE the code folder (so a deploy /
# WinSCP sync can never overwrite or delete them). Holds private/ and public/.
# Leave empty to use storage/app/private and public/storage inside the project.
# After setting it on a server, open /migrate.php once to copy existing files.
FILES_ROOT=

# Secret for public/migrate.php?key=... (deploy script). 32+ random characters;
# without it migrate.php answers 404. Generate: php -r "echo bin2hex(random_bytes(24));"
DEPLOY_KEY=
# Days a login token stays valid before signing in again.
LOGIN_TOKEN_DAYS=30
